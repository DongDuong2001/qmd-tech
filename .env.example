# ==============================================================================
# QMD-TECH PRODUCTION ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env.local for local development.
# DO NOT COMMIT .env.local TO VERSION CONTROL.
# ==============================================================================

# 1. Cloudinary Free Tier Configuration (Image Upload & Optimization)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 2. Supabase Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. Authentication & Security (JWT Secret)
QMD_ADMIN_USER=your_admin_email_or_username
QMD_ADMIN_PASSWORD=your_strong_admin_password_min_12_chars
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# 4. Site & Deployment Domain Configuration
NEXT_PUBLIC_SITE_URL=https://qmdtech.vercel.app

# 5. SePay Payment Gateway Configuration (VietQR Banking Automation)
SEPAY_MERCHANT_ID=your_sepay_merchant_id # Ví dụ: SP-LIVE-QM9B9637
SEPAY_API_KEY=your_sepay_secret_key # Khóa Secret Key từ my.sepay.vn (spsk_live_...)
SEPAY_BANK_NAME=MBBank # hoặc Vietcombank, Techcombank, ACB... theo tài khoản đã liên kết trên my.sepay.vn
SEPAY_ACCOUNT_NUMBER=0988889999 # Số tài khoản ngân hàng của bạn
SEPAY_ACCOUNT_NAME=QMD TECH CORPORATION # Tên chủ tài khoản (IN HOA KHÔNG DẤU)

# 6. Legacy / Additional Payment & Shipping Integration (Optional)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
GHN_API_TOKEN=
GHN_SHOP_ID=
GHTK_API_TOKEN=
