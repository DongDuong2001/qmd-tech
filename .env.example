# ==============================================================================
# QMD-TECH PRODUCTION ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env.local for local development.
# DO NOT COMMIT .env.local TO VERSION CONTROL.
# ==============================================================================

# 1. Cloudinary Free Tier Configuration (Image Upload & Optimization)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 2. Supabase Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. Authentication & Security (JWT Secret)
QMD_ADMIN_USER=admin@qmd.tech
QMD_ADMIN_PASSWORD=qmd@135
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# 4. Site & Deployment Domain Configuration
NEXT_PUBLIC_SITE_URL=https://qmdtech.vercel.app

# 5. Payment & Shipping Integration (Optional / Sandbox)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
GHN_API_TOKEN=
GHN_SHOP_ID=
GHTK_API_TOKEN=
